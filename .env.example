# Copie para .env.local em desenvolvimento. Em produção, cadastre em Vercel > Project > Settings > Environment Variables.

# Google Analytics 4 (ID de medição, formato G-XXXXXXXXXX). Só carrega após consentimento.
NEXT_PUBLIC_GA_ID=

# Google Search Console: valor do meta "google-site-verification" (opcional se verificado via DNS).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend: chave de API (secreta, nunca use prefixo NEXT_PUBLIC).
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "Dreh Work <diagnostico@drehwork.com>"
RESEND_FROM=
# Destino dos leads do diagnóstico (padrão: contato@drehwork.com)
DIAGNOSTIC_TO=
