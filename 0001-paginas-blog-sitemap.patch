@@ -0,0 +1,1083 @@
+---
+import StampMark from "@components/blog/StampMark.astro";
+import ButtonLink from "@components/ui/ButtonLink.astro";
+import Icon from "@components/ui/Icon.astro";
+import { blogIndex, blogPosts, formatBlogDate, type BlogPost } from "@data/blogPosts";
+import { createWhatsAppUrl } from "@lib/whatsapp";
+
+type Props = {
+  post: BlogPost;
+};
+
+const { post } = Astro.props;
+const whatsappUrl = createWhatsAppUrl(post.whatsappMessage);
+const otherPosts = blogPosts.filter((item) => item.path !== post.path).slice(0, 3);
+const calloutLabels = {
+  source: "Fonte oficial",
+  tip: "Dica",
+  warning: "Atenção"
+} as const;
+---
+
+<div class="blog-progress" aria-hidden="true"><span data-blog-progress></span></div>
+
+<article class="blog-post">
+  <header class="blog-hero">
+    <div class="container">
+      <nav class="blog-breadcrumb" aria-label="Breadcrumb">
+        <a href="/">Início</a>
+        <span aria-hidden="true">/</span>
+        <a href={blogIndex.path}>Blog</a>
+        <span aria-hidden="true">/</span>
+        <span aria-current="page">{post.category}</span>
+      </nav>
+
+      <div class="blog-hero__grid">
+        <div class="blog-hero__content">
+          <p class="blog-chip">{post.category}</p>
+          <h1>{post.title}</h1>
+          <p class="blog-hero__lead">{post.lead}</p>
+          <p class="blog-meta">
+            <span>Publicado em <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt)}</time></span>
+            {post.updatedAt !== post.publishedAt && (
+              <span>Atualizado em <time datetime={post.updatedAt}>{formatBlogDate(post.updatedAt)}</time></span>
+            )}
+            <span>{post.readingMinutes} min de leitura</span>
+          </p>
+        </div>
+
+        <div class="blog-hero__stamp">
+          <StampMark text={post.stampMark} />
+        </div>
+      </div>
+    </div>
+  </header>
+
+  <div class="container blog-layout">
+    <aside class="blog-toc" aria-label="Neste guia">
+      <p class="blog-toc__title">Neste guia</p>
+      <ol>
+        {post.sections.map((section) => (
+          <li><a href={`#${section.id}`} data-toc-link={section.id}>{section.heading}</a></li>
+        ))}
+      </ol>
+      <a class="blog-toc__cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-conversion="whatsapp">
+        <Icon name="icon-whatsapp" size="sm" />
+        <span>Tirar dúvida no WhatsApp</span>
+      </a>
+    </aside>
+
+    <div class="blog-body">
+      {post.sections.map((section) => (
+        <section id={section.id} class="blog-section" data-blog-section>
+          <h2>{section.heading}</h2>
+
+          {section.blocks.map((block) =>
+            block.type === "paragraph" ? (
+              <p>{block.text}</p>
+            ) : block.type === "list" ? (
+              block.ordered ? (
+                <ol class="blog-list blog-list--ordered">{block.items.map((item) => <li>{item}</li>)}</ol>
+              ) : (
+                <ul class="blog-list">{block.items.map((item) => <li>{item}</li>)}</ul>
+              )
+            ) : block.type === "callout" ? (
+              <aside class:list={["blog-callout", `blog-callout--${block.tone}`]}>
+                <p class="blog-callout__label">{calloutLabels[block.tone]}</p>
+                <p class="blog-callout__title">{block.title}</p>
+                <p>{block.text}</p>
+              </aside>
+            ) : block.type === "stampPreview" ? (
+              <figure class="blog-preview">
+                <div class="blog-preview__paper">
+                  <div class="blog-preview__impression">
+                    {block.lines.map((line, index) => (
+                      <span class:list={[index === 0 ? "blog-preview__line--main" : ""]}>{line}</span>
+                    ))}
+                  </div>
+                </div>
+                <figcaption>{block.caption}</figcaption>
+              </figure>
+            ) : block.type === "compare" ? (
+              <div class="blog-compare" role="table" aria-label={`Comparativo: ${block.columns[0]} e ${block.columns[1]}`}>
+                <div class="blog-compare__row blog-compare__row--head" role="row">
+                  <span role="columnheader"><span class="sr-only">Critério</span></span>
+                  <span role="columnheader">{block.columns[0]}</span>
+                  <span role="columnheader">{block.columns[1]}</span>
+                </div>
+                {block.rows.map((row) => (
+                  <div class="blog-compare__row" role="row">
+                    <span role="rowheader">{row.label}</span>
+                    <span role="cell" data-label={block.columns[0]}>{row.values[0]}</span>
+                    <span role="cell" data-label={block.columns[1]}>{row.values[1]}</span>
+                  </div>
+                ))}
+              </div>
+            ) : block.type === "steps" ? (
+              <ol class="blog-steps">
+                {block.items.map((item) => (
+                  <li>
+                    <strong>{item.title}</strong>
+                    <p>{item.text}</p>
+                  </li>
+                ))}
+              </ol>
+            ) : block.type === "checklist" ? (
+              <fieldset class="blog-checklist">
+                <legend>{block.title}</legend>
+                {block.items.map((item) => (
+                  <label>
+                    <input type="checkbox" />
+                    <span>{item}</span>
+                  </label>
+                ))}
+                <p class="blog-checklist__hint">Marque o que você já tem antes de chamar no WhatsApp.</p>
+              </fieldset>
+            ) : block.type === "messageTemplate" ? (
+              <div class="blog-template">
+                <p class="blog-template__title">{block.title}</p>
+                <textarea rows="8" data-template-text aria-label="Mensagem para pedir carimbo com urgência">{block.text}</textarea>
+                <div class="blog-template__actions">
+                  <button type="button" class="button button--secondary" data-template-copy>
+                    <span data-template-copy-label>Copiar mensagem</span>
+                  </button>
