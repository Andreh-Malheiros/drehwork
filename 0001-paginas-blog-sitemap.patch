diff --git a/src/components/blog/StampMark.astro b/src/components/blog/StampMark.astro
new file mode 100644
index 0000000..b829aa9
--- /dev/null
+++ b/src/components/blog/StampMark.astro
@@ -0,0 +1,61 @@
+---
+type Props = {
+  text: string;
+  size?: "sm" | "lg";
+  tilt?: number;
+};
+
+const { text, size = "lg", tilt = -7 } = Astro.props;
+---
+
+<span class:list={["stamp-mark", `stamp-mark--${size}`]} style={`--stamp-tilt: ${tilt}deg;`} aria-hidden="true">
+  <span class="stamp-mark__ring">
+    <span class="stamp-mark__brand">BH Carimbos</span>
+    <span class="stamp-mark__text">{text}</span>
+    <span class="stamp-mark__brand">Belo Horizonte</span>
+  </span>
+</span>
+
+<style>
+  .stamp-mark {
+    display: inline-grid;
+    place-items: center;
+    color: var(--color-orange-600);
+    transform: rotate(var(--stamp-tilt));
+    opacity: 0.94;
+  }
+
+  .stamp-mark__ring {
+    display: grid;
+    gap: 0.2em;
+    justify-items: center;
+    border: 0.22em solid currentColor;
+    border-radius: 0.6em;
+    outline: 0.08em solid currentColor;
+    outline-offset: 0.22em;
+    padding: 0.55em 0.9em;
+    text-transform: uppercase;
+    line-height: 1;
+  }
+
+  .stamp-mark__brand {
+    font-size: 0.32em;
+    font-weight: var(--font-weight-bold);
+    letter-spacing: 0.28em;
+  }
+
+  .stamp-mark__text {
+    font-size: 1em;
+    font-weight: var(--font-weight-bold);
+    letter-spacing: 0.04em;
+    white-space: nowrap;
+  }
+
+  .stamp-mark--lg {
+    font-size: clamp(2rem, 5vw, 3.4rem);
+  }
+
+  .stamp-mark--sm {
+    font-size: 1.35rem;
+  }
+</style>
